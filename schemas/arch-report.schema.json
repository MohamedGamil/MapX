{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/@mgamil/mapx/schemas/arch-report.schema.json",
  "title": "MapX architecture report",
  "description": "What `mapx check --format json` prints: the findings of the architecture rules (.mapx/architecture.jsonc) on the index, with counts, layer sizes and the layer-to-layer matrix.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "counts", "findings", "layers", "layerEdges", "configErrors"],
  "properties": {
    "version": { "const": 1 },
    "counts": {
      "description": "Findings per kind, before --report-* options hide any.",
      "type": "object",
      "additionalProperties": false,
      "required": ["violation", "skipped", "uncovered", "allowed", "warning", "error"],
      "properties": {
        "violation": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "uncovered": { "type": "integer", "minimum": 0 },
        "allowed": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "elements", "files", "overlay"],
        "properties": {
          "name": { "type": "string" },
          "elements": { "type": "integer", "minimum": 0 },
          "files": { "type": "integer", "minimum": 0 },
          "overlay": { "type": "boolean" }
        }
      }
    },
    "layerEdges": {
      "description": "Dependencies per (source layer, target layer).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "allowed", "violations", "skipped"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "allowed": { "type": "integer", "minimum": 0 },
          "violations": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "configErrors": { "type": "array", "items": { "type": "string" } },
    "selection": {
      "description": "What mapx check evaluated and kept: the view and the --layer/--rule filters (null when not given). --compare refuses a base report with another view, or narrowed by a filter the head does not share.",
      "type": "object",
      "additionalProperties": false,
      "required": ["view", "layer", "rule"],
      "properties": {
        "view": { "type": ["string", "null"] },
        "layer": { "type": ["string", "null"] },
        "rule": { "type": ["string", "null"] }
      }
    }
  },
  "definitions": {
    "end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "file"],
      "properties": {
        "element": { "description": "A symbol's qualified name, a file's path, or a Go package's import path.", "type": "string" },
        "file": { "description": "Workspace-relative file (a directory for a package).", "type": "string" },
        "layer": { "description": "Layers, comma-separated.", "type": "string" },
        "repo": { "type": "string" },
        "line": { "description": "First line of the dependency in the source file.", "type": "integer", "minimum": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "severity", "fingerprint", "message"],
      "properties": {
        "kind": { "enum": ["violation", "skipped", "uncovered", "allowed", "warning", "error"] },
        "rule": { "description": "disallowed-layer, internal-element, private-layer, uncovered, multi-layer, empty-layer, unsupported-selector, plus-cycle, config, stale-baseline …", "type": "string" },
        "severity": { "enum": ["error", "warn", "info"] },
        "source": { "$ref": "#/definitions/end" },
        "target": { "$ref": "#/definitions/end" },
        "edgeType": { "type": "string" },
        "verifiability": { "enum": ["verified", "inferred"] },
        "layer": { "description": "For layer-level findings (empty-layer, plus-cycle, unsupported-selector).", "type": "string" },
        "edges": { "description": "Stored edges this finding stands for.", "type": "integer", "minimum": 1 },
        "fingerprint": { "description": "Stable identity: rule, both elements and the edge type, never a line number.", "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "identity": {
          "description": "The fingerprint's inputs where they differ from the shown elements: a file-level end is its file path; an end outside the root repo names its repo (workspace-relative path).",
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "target"],
          "properties": {
            "source": { "type": "string" },
            "target": { "type": "string" },
            "sourceRepo": { "type": "string" },
            "targetRepo": { "type": "string" }
          }
        },
        "skippedBy": { "description": "Why a skipped finding is skipped: a baseline entry, or the base report of --compare.", "enum": ["baseline", "compare"] },
        "location": {
          "description": "Where to fix a finding that is not about code: a stale baseline entry is in the baseline file (workspace-relative, with /) at a JSON pointer.",
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": { "type": "string" },
            "pointer": { "type": "string" }
          }
        },
        "message": { "type": "string" }
      }
    }
  }
}
