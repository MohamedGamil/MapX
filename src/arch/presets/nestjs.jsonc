// mapx:preset/nestjs: a NestJS application.
// AR-15. By Nest's file-name conventions and decorators.
// Controllers reach the domain only through providers; entities depend on nothing.
// No parameters: the file names place every file, wherever it is.
{
  "layers": [
    // @Module classes: they wire controllers, providers and other modules.
    { "name": "Module", "selectors": [{ "path": "**/*.module.{ts,js}" }, { "decorator": "Module" }] },
    // @Controller classes: the HTTP surface.
    { "name": "Controller", "selectors": [{ "path": "**/*.controller.{ts,js}" }, { "decorator": "Controller" }] },
    // Guards, interceptors, pipes, filters, middleware and auth strategies.
    { "name": "Enhancer", "selectors": [{ "path": "**/*.{guard,interceptor,pipe,filter,middleware,strategy}.{ts,js}" }] },
    // Services, providers and repositories (@Injectable).
    { "name": "Provider", "selectors": [{ "path": "**/*.{service,provider,repository}.{ts,js}" }] },
    // Data transfer objects.
    { "name": "Dto", "selectors": [{ "path": "**/*.dto.{ts,js}" }, { "path": "**/dto/**" }] },
    // Persistence entities.
    { "name": "Entity", "selectors": [{ "path": "**/*.entity.{ts,js}" }, { "path": "**/entities/**" }] }
  ],
  "rules": {
    "Module": ["Controller", "Enhancer", "Provider", "Entity"],
    "Controller": ["Enhancer", "Provider", "Dto"],
    "Enhancer": ["Provider", "Dto", "Entity"],
    "Provider": ["Dto", "Entity"],
    "Dto": ["Entity"],
    "Entity": []
  }
}
