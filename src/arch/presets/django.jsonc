// mapx:preset/django: a Django project.
// AR-15. By Django's module-name conventions, in every app, and by the framework's base classes
// (M5-17-R1): a class that extends models.Model, or a Django or REST framework view, is placed by its
// ancestry in whichever module it is; the module names stay the fallback for everything else.
// Models never depend on views, forms or serializers; URLconfs reach views only.
// No parameters: the module names place every file, in whichever app it is.
{
  "layers": [
    // URLconfs.
    { "name": "Urls", "selectors": [{ "path": "**/urls.py" }] },
    // Views and viewsets: by module, and any class-based view (django.views, the REST framework's
    // views, generics and viewsets).
    { "name": "Views", "selectors": [
      { "path": "**/{views,viewsets}.py" },
      { "path": "**/views/**" },
      { "inherits": "/^(django\\.views|rest_framework\\.(views|generics|viewsets))\\./" }
    ] },
    // The admin site.
    { "name": "Admin", "selectors": [{ "path": "**/admin.py" }] },
    // Management commands.
    { "name": "Commands", "selectors": [{ "path": "**/management/commands/**" }] },
    // Forms and REST framework serializers.
    { "name": "Forms", "selectors": [{ "path": "**/forms.py" }, { "path": "**/forms/**" }] },
    { "name": "Serializers", "selectors": [{ "path": "**/serializers.py" }, { "path": "**/serializers/**" }] },
    // Schema migrations. They use historical models (apps.get_model), never the current ones, as
    // Django's docs require: a migration importing a model is a violation (M5-17-R1).
    { "name": "Migrations", "selectors": [{ "path": "**/migrations/**" }] },
    // Models: by module, and any class that extends django.db.models.Model.
    { "name": "Models", "selectors": [{ "path": "**/models.py" }, { "path": "**/models/**" }, { "extends": "django.db.models.Model" }] }
  ],
  "rules": {
    "Urls": ["Views"],
    "Views": ["Forms", "Serializers", "Models"],
    "Admin": ["Forms", "Models"],
    "Commands": ["Models"],
    "Forms": ["Models"],
    "Serializers": ["Models"],
    "Migrations": [],
    "Models": []
  }
}
