# Ignore Core app artifacts
*.db
*.db-journal
*.db-wal

# Ignore NodeJS app artifacts
node_modules/
dist/
coverage/
.env
# Fixture .env files are test inputs (M2-02), not secrets.
!tests/fixtures/**/.env
.idea
*.log
*.tsbuildinfo

# Ignore build artifacts
build
out

# Ignore test artifacts
test-results/
coverage/
.vitest/

# Ignore editor-specific files
*.sublime-project
*.sublime-workspace
*.code-workspace

# Ignore OS-specific files
Thumbs.db
Desktop.ini
.DS_Store

# Ignore other files
*.bak
*.tmp
*.swp
*_walkthrough.md
scratch/

# Agents & IDEs
.vscode/
.agents/
.cursor/
.gemini/
.continue/

.mapx/
# Fixture architecture configs live in .mapx/ and must be committed (M5-01/M5-02);
# anything a scan writes there (mapx.db, caches) stays ignored.
!tests/fixtures/**/.mapx/
tests/fixtures/**/.mapx/*
!tests/fixtures/**/.mapx/*.jsonc
!tests/fixtures/**/.mapx/architecture.baseline.json
!tests/fixtures/**/.mapx/architecture/
