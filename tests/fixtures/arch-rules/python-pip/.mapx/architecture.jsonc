// M5-22-R1 fixture: pip attribution (requirements files, no lockfile). Two layers and no cross-layer dependency, so the app yields no finding; its value is the external references it labels (expected-externals.json).
{
  "$schema": "../../../../schemas/architecture.schema.json",
  "layers": [
    { "name": "Domain", "selectors": [{ "path": "app/domain/**" }] },
    { "name": "Infrastructure", "selectors": [{ "path": "app/infrastructure/**" }] }
  ],
  "rules": { "Domain": [], "Infrastructure": ["Domain"] }
}
