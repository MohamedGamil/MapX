VITE_API_URL=/api
# M2-04-R2: a quoted value with a trailing comment, and ${VAR} expansion, read as Vite reads them
VITE_SHOP_URL="/shop" # storefront
VITE_BILLING_URL=${VITE_API_URL}/billing
# M2-06-R1: an absolute base URL from an env file is one of the workspace's own hosts
VITE_REPORTS_URL=https://api.example.com
# M2-06-R2: a second workspace host, served only by the Route::domain(ops.example.com) group
VITE_OPS_URL=https://ops.example.com
