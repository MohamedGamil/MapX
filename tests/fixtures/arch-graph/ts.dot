digraph "MapX layers" {
  graph [compound=true, rankdir=TB, label="Dependencies: 16 allowed, 18 violations (2 at warn), 2 skipped, 4 uncovered; 1 hidden layer counted, not drawn", labelloc=b, fontname="Helvetica", fontsize=10];
  node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#475569", fontname="Helvetica"];
  edge [color="#64748b", fontcolor="#475569", fontname="Helvetica", fontsize=10];

  subgraph cluster_1 {
    label="Web &amp; \"UI\"";
    labelloc=t;
    style="rounded,dashed";
    color="#94a3b8";
    n1 [label="Controller", fillcolor="#fde68a"];
  }

  subgraph cluster_0 {
    label="Domain";
    labelloc=t;
    style="rounded,dashed";
    color="#94a3b8";
    n2 [label="Domain"];
    n4 [label="Shared"];
  }

  n0 [label="Application"];
  n3 [label="Reports \"v2\" <beta>"];

  n1 -> n0 [label="4"];
  n1 -> n0 [label="4", color="#dc2626", fontcolor="#dc2626", penwidth=2];
  n1 -> n2 [label="2", color="#dc2626", fontcolor="#dc2626", penwidth=2, lhead=cluster_0];
  n1 -> n2 [label="2", color="#d97706", fontcolor="#d97706", lhead=cluster_0];
  n1 -> n4 [label="2", color="#dc2626", fontcolor="#dc2626", penwidth=2];
  n0 -> n2 [label="2", lhead=cluster_0];
  n0 -> n2 [label="4", color="#dc2626", fontcolor="#dc2626", penwidth=2, lhead=cluster_0];
  n0 -> n4 [label="2"];
  n2 -> n0 [label="2", color="#d97706", fontcolor="#d97706"];
  n2 -> n4 [label="4"];
  n4 -> n0 [label="2", color="#dc2626", fontcolor="#dc2626", penwidth=2];
  n4 -> n2 [label="2", color="#94a3b8", fontcolor="#94a3b8", style=dashed];
}
